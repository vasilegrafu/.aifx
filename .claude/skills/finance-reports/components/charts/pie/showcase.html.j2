{# The `pie` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a donut, four slices — the default, and about the practical maximum</h3>
      {{ c.pie(slices=d.revenue_mix,
               caption="Revenue by segment, FY25",
               unit="USD millions",
               note="Data Center and Client are 81% of revenue between them.") }}
    </section>
    <hr>
    <section>
      <h3>donut=false — a full pie, and two slices, where the form is strongest</h3>
      {{ c.pie(slices=d.ownership, donut=false,
               caption="Share register",
               unit="percent of shares outstanding",
               height=280,
               note="Two parts of one whole against a half: the one comparison a pie makes better than a bar.") }}
    </section>
{% endblock %}
