{# The `stacked-area` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two bands — a legend appears; the top edge is already the total</h3>
      {{ c.stacked_area(series=[d.cloud, d.license], categories=d.quarters,
               caption="Cloud and License revenue",
               unit="USD, billions",
               note="Cloud was already the larger band and more than doubles; License is flat.") }}
    </section>
    <hr>
    <section>
      <h3>four bands with y_name — composition and total, one figure</h3>
      {{ c.stacked_area(series=[d.cloud, d.license, d.hardware, d.services],
               categories=d.quarters,
               caption="Revenue by segment",
               unit="USD, billions",
               y_name="Revenue (USD bn)",
               note="The whole grew 52%, and 86% of that increase is the Cloud band.") }}
    </section>
{% endblock %}
