{# The `stacked-normalized` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two segments — a legend appears; both columns are 100% tall</h3>
      {{ c.stacked_normalized(series=[d.p_product, d.p_services], categories=d.peers,
               caption="Revenue mix, product against services",
               note="NVDA is 2.3x AMD's size; here the two columns are the same height.") }}
    </section>
    <hr>
    <section>
      <h3>four segments with y_name — the totals disappear, by design</h3>
      {{ c.stacked_normalized(series=[d.cloud, d.license, d.hardware, d.services],
               categories=d.years,
               caption="Revenue mix by fiscal year",
               y_name="Share of revenue (%)",
               note="FY25 is 2.1x the size of FY21. Nothing here shows that — the mix is the argument.") }}
    </section>
{% endblock %}
