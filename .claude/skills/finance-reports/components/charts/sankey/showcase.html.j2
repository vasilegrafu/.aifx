{# The `sankey` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>the smallest sankey that is still one — a single split</h3>
      {{ c.sankey(nodes=d.simple_nodes, links=d.simple_links,
               caption="Operating cash flow, deployed",
               unit="USD millions",
               height=260,
               note="Capex takes 22%; the rest is free cash flow. 1,420 + 4,980 = 6,400.") }}
    </section>
    <hr>
    <section>
      <h3>three stages — where conservation stops being checkable by eye</h3>
      {{ c.sankey(nodes=d.nodes, links=d.links,
               caption="FY25 income statement",
               unit="USD millions",
               label_room=170,
               note="Every intermediate node balances; R&D alone takes 47% of gross profit.") }}
    </section>
{% endblock %}
