{# The `bar-negative` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>one series crossing zero — misses fall below the axis, beats above</h3>
      {{ c.bar_negative(series=[d.surprise], categories=d.quarters,
               caption="EPS surprise against consensus",
               unit="USD per share",
               note="Five beats, three misses; the zero line is the verdict.") }}
    </section>
    <hr>
    <section>
      <h3>y_name — a contribution, where the axis has to say what it measures</h3>
      {{ c.bar_negative(series=[d.contribution], categories=d.segments,
               caption="Contribution to revenue growth",
               unit="USD, billions",
               y_name="Contribution (USD bn)",
               note="Hardware subtracted; Cloud paid for it and more.") }}
    </section>
    <hr>
    <section>
      <h3>two series — a legend appears, and both cross zero independently</h3>
      {{ c.bar_negative(series=[d.fy25, d.fy24], categories=d.segments,
               caption="Contribution by year",
               unit="USD, billions",
               y_name="Contribution (USD bn)",
               note="Hardware has subtracted in both years; License only in FY24.") }}
    </section>
{% endblock %}
