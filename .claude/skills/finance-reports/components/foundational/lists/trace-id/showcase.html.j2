{# The `trace-id` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>three identifiers, each anchorable</h3>
      <p>Covered by {% for t in d["ids"] %}{{ c.trace_id(t) }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    </section>
{% endblock %}
