{# The `approval-block` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>three signatories — research, investment, compliance</h3>
      {{ c.approval_block(rows=d.rows) }}
    </section>
    <hr>
    <section>
      <h3>a single signatory — the smallest form that still says who</h3>
      {{ c.approval_block(rows=d.single) }}
    </section>
{% endblock %}
