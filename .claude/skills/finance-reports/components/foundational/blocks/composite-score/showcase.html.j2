{# The `composite-score` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>the score with its workings, and the band it falls in</h3>
      {{ c.composite_score(name="Altman Z-score",
               formula="Z = 1.2·X₁ + 1.4·X₂ + 3.3·X₃ + 0.6·X₄ + 1.0·X₅",
               inputs=d.inputs, score=d.score, band=d.band,
               tone=d.tone, bands=d.bands,
               caption="Altman Z-score, FY25",
               note="One term supplies 1.72 of the 3.99 — 43% of the score comes from market value of equity, which moves with the share price rather than with the business.") }}
    </section>
    <hr>
    <section>
      <h3>the band alone — the form to avoid, and why the header says so</h3>
      {{ c.composite_score(name="Altman Z-score", score=d.score,
               band=d.band, tone=d.tone, bands=d.bands) }}
    </section>
{% endblock %}
