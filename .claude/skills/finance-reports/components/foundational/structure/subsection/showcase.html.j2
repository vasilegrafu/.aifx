{# The `subsection` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two subsections nested inside their section</h3>
      {% call c.section(d.parent.id, d.parent.label) %}
      {% for s in d.children %}{% call c.subsection(s.id, s.label) %}
        {{ c.prose(text="Body of " + s.label + ".") }}
      {% endcall %}{% endfor %}
      {% endcall %}
    </section>
{% endblock %}
