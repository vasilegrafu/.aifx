{# The `metadata-header` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>the cover — a kicker and a title, and nothing that maintains itself</h3>
      {{ c.metadata_header(d.report_name, d.title) }}
      {{ c.prose(text=d.asof) }}
    </section>
{% endblock %}
