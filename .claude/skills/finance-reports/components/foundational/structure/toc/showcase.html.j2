{# The `toc` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>contents and sections rendered from one list, so they cannot drift</h3>
      {{ c.toc(entries=d.entries) }}
      {% for e in d.entries %}{% call c.section(e.id, e.label) %}
        {{ c.prose(text="Body of " + e.label + ".") }}
      {% endcall %}{% endfor %}
    </section>
{% endblock %}
