{# The `roll-forward` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>net debt, opening to closing, in two columns that both close</h3>
      {{ c.roll_forward(periods=d.periods, rows=d.rows,
               caption="Net debt roll-forward", unit="$m",
               fmt="money",
               note="Free cash flow reduces net debt and is shown negative. FY24 closes where FY25 opens.") }}
    </section>
{% endblock %}
