{# purpose: two-way sensitivity grid: one output across two assumptions, base case marked #}
{# data: cols: str[]   rows[] {row_head:str, cells[] {display:str, tone?:low|mid|high, base?:bool}} #}
{% macro sensitivity_table(cols=[], rows=[], col_label="", row_label="", caption="", note="") %}
  <table class="sens">
  {% if caption %}<caption>{{ caption }}</caption>{% endif %}
    <thead>
      <tr>
        <th class="sens-corner"><span class="sens-row-label">{{ row_label }}</span><span class="sens-col-label">{{ col_label }}</span></th>
        {% for c in cols %}<th>{{ c }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.row_head }}</th>
        {% for c in r.cells %}
        <td class="sens-cell{% if c.get('tone') %} sens-{{ c.tone }}{% endif %}{% if c.get('base') %} sens-base{% endif %}">{{ c.display }}</td>
        {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if note %}<p class="sens-note">{{ note }}</p>{% endif %}
{% endmacro %}
