{# The `table` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>five columns, default width</h3>
      {{ c.table(d.headers, d.rows) }}
    </section>
    <hr>
    <section>
      <h3>nine columns with wide=true — scrolls rather than squeezes</h3>
      {{ c.table(d.wide_headers, d.wide_rows, wide=true) }}
    </section>
{% endblock %}
