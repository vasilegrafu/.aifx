{# The `figure` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a figure whose alt text carries what the picture carries</h3>
      {{ c.figure(src=d.src, alt=d.alt, caption=d.caption) }}
    </section>
{% endblock %}
