{# The `quote` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>attributed — somebody said this, and it can be checked</h3>
      {{ c.quote(text=d.text, source=d.source) }}
    </section>
    <hr>
    <section>
      <h3>unattributed — the report's own voice, which looks the same</h3>
      {{ c.quote(text=d.own) }}
    </section>
{% endblock %}
