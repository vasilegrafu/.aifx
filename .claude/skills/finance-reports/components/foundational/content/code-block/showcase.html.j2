{# The `code-block` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a framed sample with its path and language</h3>
      {% call c.code_block(path=d.path, lang=d.lang) %}{% raw %}def _validate_context(self, d):
    """Opening plus movements equals closing, in every column."""
    for i, period in enumerate(d["periods"]):
        opening = d["rows"][0]["cells"][i]
        closing = d["rows"][-1]["cells"][i]
        moved = sum(r["cells"][i] for r in d["rows"][1:-1])
        assert abs(opening + moved - closing) < 0.01
{% endraw %}{% endcall %}
    </section>
{% endblock %}
