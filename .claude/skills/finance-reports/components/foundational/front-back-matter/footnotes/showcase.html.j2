{# The `footnotes` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>prose carrying markers, and the notes they point at</h3>
      <p>Segment revenue rose 15.4% on the restated basis.<sup class="fn"><a id="fnref-1" href="#fn-1">1</a></sup>
      Free cash flow of $2,530m<sup class="fn"><a id="fnref-2" href="#fn-2">2</a></sup>
      covered the dividend 2.4 times, against a peer median of 1.8.<sup class="fn"><a id="fnref-3" href="#fn-3">3</a></sup></p>
      {{ c.footnotes(notes=d.notes) }}
    </section>
{% endblock %}
