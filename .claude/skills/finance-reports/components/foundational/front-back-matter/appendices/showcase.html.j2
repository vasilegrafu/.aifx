{# The `appendices` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two appendices inside the wrapper that restarts their lettering</h3>
      {% call c.appendices() %}
      {% for a in d["items"] %}{% call c.appendix(a.id, a.heading) %}
        {{ c.prose(text="Content for " + a.heading + ".") }}
      {% endcall %}{% endfor %}
      {% endcall %}
    </section>
{% endblock %}
