{# The `recommendation` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a positive view</h3>
      {{ c.recommendation(action="Add", tone="good", facts=d.buy,
               rationale="Data centre momentum is not in the multiple yet.") }}
    </section>
    <hr>
    <section>
      <h3>neutral — the hardest one to write and the most common</h3>
      {{ c.recommendation(action="Hold", tone="neutral", facts=d.hold,
               rationale="Fairly valued on every method except the sum of the parts.") }}
    </section>
    <hr>
    <section>
      <h3>negative</h3>
      {{ c.recommendation(action="Reduce", tone="bad", facts=d.sell,
               rationale="The multiple assumes the supplier constraint resolves. It may not.") }}
    </section>
{% endblock %}
