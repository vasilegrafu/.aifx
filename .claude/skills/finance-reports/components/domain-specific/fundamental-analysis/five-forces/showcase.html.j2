{# The `five-forces` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>all five forces, each with the evidence behind its rating</h3>
      {{ c.five_forces(forces=d.forces,
               caption="Competitive position",
               verdict="Supplier power is the binding constraint; everything else is favourable.") }}
    </section>
{% endblock %}
