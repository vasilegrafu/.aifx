{# The `dupont` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>three factors and the result they multiply to</h3>
      {{ c.dupont(factors=d.factors, result=d.result, periods=d.periods,
               caption="DuPont decomposition of return on equity") }}
    </section>
    <hr>
    <section>
      <h3>the factors alone — where the reader multiplies</h3>
      {{ c.dupont(factors=d.factors, periods=d.periods,
               caption="Return drivers") }}
    </section>
{% endblock %}
