{# The `thesis-pillars` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>three pillars, each with evidence and a stated falsifier</h3>
      {{ c.thesis_pillars(items=d.items) }}
    </section>
    <hr>
    <section>
      <h3>a claim with evidence but no falsifier — visibly weaker</h3>
      {{ c.thesis_pillars(items=d.partial) }}
    </section>
{% endblock %}
