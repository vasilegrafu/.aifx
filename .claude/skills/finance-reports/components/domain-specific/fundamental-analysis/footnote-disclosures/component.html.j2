{# purpose: the numbered accounting disclosures that statement lines cite, with the ones that matter flagged #}
{# data: items[] {num:int, title:str, body:str, flag?:watch} — anchors at id=note-<num> #}
{% macro footnote_disclosures(items=[], caption="") %}
  <div class="fa-footnote-disclosures">
  {% if caption %}<p class="fa-footnote-disclosures-caption">{{ caption }}</p>{% endif %}
  {% for it in items %}
    <section class="fa-footnote-disclosures-item{% if it.get('flag') %} fa-footnote-disclosures-item-{{ it.flag }}{% endif %}" id="note-{{ it.num }}">
      <p class="fa-footnote-disclosures-head">
        <span class="fa-footnote-disclosures-num">Note {{ it.num }}</span>
        <span class="fa-footnote-disclosures-title">{{ it.title }}</span>
        {% if it.get('flag') %}<span class="fa-footnote-disclosures-flag">{{ it.flag }}</span>{% endif %}
      </p>
      <p class="fa-footnote-disclosures-body">{{ it.body }}</p>
    </section>
  {% endfor %}
  </div>
{% endmacro %}
