{# The `unit-economics` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>headline figures above the benchmarked table</h3>
      {{ c.unit_economics(headline=d.headline, rows=d.rows,
               caption="Unit economics against the peer range") }}
    </section>
    <hr>
    <section>
      <h3>the table alone — benchmarks without the headline</h3>
      {{ c.unit_economics(rows=d.rows, caption="Unit economics") }}
    </section>
{% endblock %}
