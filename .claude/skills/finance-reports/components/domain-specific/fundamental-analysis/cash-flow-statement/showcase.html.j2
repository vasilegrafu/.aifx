{# The `cash-flow-statement` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>three sections, signed flows, one row note</h3>
      {{ c.cash_flow_statement(rows=d.rows, periods=d.periods,
               caption="Cash flow statement",
               unit="USD millions",
               source="Company filings") }}
    </section>
    <hr>
    <section>
      <h3>no caption or unit — the bare table, for embedding under a heading</h3>
      {{ c.cash_flow_statement(rows=d.rows, periods=d.periods) }}
    </section>
{% endblock %}
