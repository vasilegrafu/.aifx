{# purpose: where operating cash went — capex, M&A, dividends, buybacks, debt — as a share of it #}
{# data: rows[] {use:str, cells:str[], cumulative:str, share:num}  source_line? {label, cells, cumulative} — cells pre-formatted #}
{% macro capital_allocation(periods=[], rows=[], caption="", unit="", source_line=none, note="") %}
  <table class="fin">
  {% if caption or unit %}<caption>{{ caption }}{% if unit %} <span class="fin-unit">{{ unit }}</span>{% endif %}</caption>{% endif %}
    <thead><tr><th>Use of cash</th>{% for p in periods %}<th>{{ p }}</th>{% endfor %}<th>Cumulative</th><th class="fa-capital-allocation-share-head">% of source</th></tr></thead>
    {% if source_line %}
    <tbody class="fa-capital-allocation-source">
      <tr><th scope="row">{{ source_line.label }}</th>
        {% for v in source_line.cells %}<td>{{ v }}</td>{% endfor %}
        <td>{{ source_line.cumulative }}</td><td></td>
      </tr>
    </tbody>
    {% endif %}
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.use }}</th>
        {% for v in r.cells %}<td{% if v is string and (v.startswith("(") or v.startswith("-") or v.startswith("−")) %} class="neg"{% endif %}>{{ v }}</td>{% endfor %}
        <td class="fa-capital-allocation-cum">{{ r.cumulative }}</td>
        <td class="fa-capital-allocation-share">
          <span class="fa-capital-allocation-track"><span class="fa-capital-allocation-fill" data-pct="{{ r.share }}%"></span></span>
          <span class="fa-capital-allocation-pct">{{ r.share }}%</span>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if note %}<p class="fin-source">{{ note }}</p>{% endif %}
{% endmacro %}
