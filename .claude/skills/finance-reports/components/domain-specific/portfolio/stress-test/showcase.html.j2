{# The `stress-test` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>four scenarios — two fully toned, two where only the bar colours</h3>
      {{ c.stress_test(rows=d.rows,
               caption="Stress scenarios against $2,450m",
               note="Impacts are one-year mark-to-market on the current book, applied independently rather than jointly.") }}
    </section>
{% endblock %}
