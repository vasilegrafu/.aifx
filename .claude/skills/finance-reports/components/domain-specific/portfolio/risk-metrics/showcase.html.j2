{# The `risk-metrics` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>seven statistics against the benchmark, each with its reading</h3>
      {{ c.risk_metrics(rows=d.rows, subject_label=d.subject,
               benchmark_label=d.benchmark,
               caption="Risk and return, five years to FY25") }}
    </section>
{% endblock %}
