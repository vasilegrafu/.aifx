{# The `performance-table` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>strategy, benchmark and the excess between them</h3>
      {{ c.performance_table(periods=d.periods, rows=d.rows,
               caption="Total return, net of fees") }}
    </section>
{% endblock %}
