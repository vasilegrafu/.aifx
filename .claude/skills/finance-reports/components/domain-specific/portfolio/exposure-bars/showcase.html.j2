{# The `exposure-bars` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>sector exposure, with the amount each percentage implies</h3>
      {{ c.exposure_bars(items=d["items"],
               caption="Sector exposure, $2,450m") }}
    </section>
{% endblock %}
