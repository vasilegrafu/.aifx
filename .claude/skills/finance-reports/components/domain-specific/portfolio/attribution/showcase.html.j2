{# The `attribution` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>four segments decomposed into allocation and selection</h3>
      {{ c.attribution(rows=d.rows, total_row=d.total_row,
               caption="Brinson attribution against MSCI World",
               period="1Y",
               note="Selection contributes +0.99pt of the +1.40pt excess; allocation adds +0.40pt. Technology alone supplies +1.02pt of selection.") }}
    </section>
{% endblock %}
