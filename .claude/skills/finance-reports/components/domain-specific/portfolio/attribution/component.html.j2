{# purpose: Brinson attribution: allocation effect, selection effect and their total by segment #}
{# data: rows[] {segment:str, pw, bw, pr, br, allocation, selection, total — all pre-formatted str}  total_row? {label, cells} #}
{% macro attribution(rows=[], caption="", period="", total_row=none, note="") %}
  <table class="fin portfolio-attribution">
  {% if caption or period %}<caption>{{ caption }}{% if period %} <span class="fin-asof">{{ period }}</span>{% endif %}</caption>{% endif %}
    <thead>
      <tr>
        <th>Segment</th>
        <th>Port. weight</th><th>Bench. weight</th>
        <th>Port. return</th><th>Bench. return</th>
        <th>Allocation</th><th>Selection</th><th>Total</th>
      </tr>
    </thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.segment }}</th>
        <td>{{ r.pw }}</td><td class="portfolio-attribution-bench">{{ r.bw }}</td>
        <td>{{ r.pr }}</td><td class="portfolio-attribution-bench">{{ r.br }}</td>
        <td{% if r.allocation is string and (r.allocation.startswith("-") or r.allocation.startswith("−")) %} class="neg"{% endif %}>{{ r.allocation }}</td>
        <td{% if r.selection is string and (r.selection.startswith("-") or r.selection.startswith("−")) %} class="neg"{% endif %}>{{ r.selection }}</td>
        <td class="portfolio-attribution-total{% if r.total is string and (r.total.startswith("-") or r.total.startswith("−")) %} neg{% endif %}">{{ r.total }}</td>
      </tr>
    {% endfor %}
    </tbody>
    {% if total_row %}
    <tfoot><tr class="total"><th scope="row">{{ total_row.label }}</th>{% for v in total_row.cells %}<td>{{ v }}</td>{% endfor %}</tr></tfoot>
    {% endif %}
  </table>
  {% if note %}<p class="fin-source">{{ note }}</p>{% endif %}
{% endmacro %}
