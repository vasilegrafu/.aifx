{# The shell every component showcase extends — the twin of
   reports/_report.master.html.j2, and it does the same job: doctype, head, the
   asset pair, the cover block, and one {% block content %} for the view to
   fill. It exists so those are written ONCE rather than in every component's
   view; the asset pair especially, which branches on `asset_bundles` and is
   not something to restate 110 times. A showcase always passes "local" — see
   _showcase_controller.render().

   It calls no macro but metadata_header, and holds no case-specific markup —
   what a component shows is its view's business. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
{% include "css/css.loader.html.j2" %}
{% include "js/js.loader.html.j2" %}
{% block head %}{% endblock %}
</head>
<body>
  <main>
{{ c.metadata_header("component showcase", component_name) }}
{% block content %}{% endblock %}
  </main>
</body>
</html>
