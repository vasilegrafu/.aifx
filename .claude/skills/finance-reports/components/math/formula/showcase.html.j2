{# The `formula` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>the weighted average cost of capital</h3>
      {{ c.formula(tex=d.wacc) }}
    </section>
    <hr>
    <section>
      <h3>Gordon growth and the Sharpe ratio</h3>
      {{ c.formula(tex=d.gordon) }}
      {{ c.formula(tex=d.sharpe) }}
    </section>
{% endblock %}
