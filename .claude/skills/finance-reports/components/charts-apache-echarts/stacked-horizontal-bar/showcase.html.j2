{# The `stacked-horizontal-bar` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two segments — long labels read straight, which is the whole point</h3>
      {{ c.charts_apache_echarts_stacked_horizontal_bar(series=[d.product, d.support], categories=d.categories, label_room=230,
               caption="Revenue by line of business",
               unit="USD, billions",
               note="Five category names no vertical axis could carry unrotated.") }}
    </section>
    <hr>
    <section>
      <h3>three segments with y_name — the measured axis is the horizontal one</h3>
      {{ c.charts_apache_echarts_stacked_horizontal_bar(series=[d.product, d.support, d.licensing],
               categories=d.categories, label_room=230,
               caption="Revenue by line of business and type",
               unit="USD, billions",
               y_name="Revenue (USD bn)",
               note="Licensing is small everywhere, and visible only because it is stacked.") }}
    </section>
{% endblock %}
