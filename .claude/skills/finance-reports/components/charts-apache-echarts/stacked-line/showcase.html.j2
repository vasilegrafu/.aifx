{# The `stacked-line` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>two series — a legend appears; the upper line is already a sum</h3>
      {{ c.charts_apache_echarts_stacked_line(series=[d.engineering, d.sales], categories=d.years,
               caption="Headcount, engineering and go-to-market",
               unit="thousands of employees",
               note="Read the upper line as the pair combined, not as sales alone.") }}
    </section>
    <hr>
    <section>
      <h3>three series with y_name — the top line is total headcount</h3>
      {{ c.charts_apache_echarts_stacked_line(series=[d.engineering, d.sales, d.ga], categories=d.years,
               caption="Headcount by function",
               unit="thousands of employees",
               y_name="Headcount (thousands)",
               note="Total up 77%, and engineering is two thirds of that increase.") }}
    </section>
{% endblock %}
