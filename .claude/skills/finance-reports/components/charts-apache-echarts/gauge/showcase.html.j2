{# The `gauge` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a percentage on 0..100 — the form everyone expects</h3>
      {{ c.charts_apache_echarts_gauge(value=d.utilisation.value, minimum=d.utilisation.minimum,
               maximum=d.utilisation.maximum,
               caption="Fab capacity utilisation",
               unit="%",
               note="78.4% of installed capacity. The span is the whole reading.") }}
    </section>
    <hr>
    <section>
      <h3>a ratio on 0..10 — a span that is not a percentage</h3>
      {{ c.charts_apache_echarts_gauge(value=d.coverage.value, minimum=d.coverage.minimum,
               maximum=d.coverage.maximum,
               caption="Interest coverage",
               unit="x",
               note="4.2x against a 10x scale someone chose; the maximum is an editorial act.") }}
    </section>
    <hr>
    <section>
      <h3>a bounded rate on 0..60 — where a misread maximum would mislead</h3>
      {{ c.charts_apache_echarts_gauge(value=d.payout.value, minimum=d.payout.minimum,
               maximum=d.payout.maximum,
               caption="Dividend payout ratio",
               unit="%",
               note="31.5% of earnings paid out, on a scale topping at 60 rather than 100.") }}
    </section>
{% endblock %}
