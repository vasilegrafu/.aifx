{# The `smoothed-line` showcase — the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>one series — the curve reads as trend, the month-to-month noise recedes</h3>
      {{ c.charts_apache_echarts_smoothed_line(series=[d.shipments], categories=d.months,
               caption="Units shipped by month",
               unit="thousands",
               note="Up through both years; the monthly zig-zag is not the story.") }}
    </section>
    <hr>
    <section>
      <h3>two series — a legend appears, and two curves stay separable</h3>
      {{ c.charts_apache_echarts_smoothed_line(series=[d.north, d.emea], categories=d.months,
               caption="Shipments by region",
               unit="thousands",
               note="EMEA tracks North America at roughly two thirds the volume.") }}
    </section>
    <hr>
    <section>
      <h3>y_name — a bounded rate, where the axis must say what it measures</h3>
      {{ c.charts_apache_echarts_smoothed_line(series=[d.utilisation], categories=d.months,
               caption="Capacity utilisation",
               unit="percent",
               y_name="Utilisation (%)",
               note="Range-bound: the smoothing shows the band, not a direction.") }}
    </section>
{% endblock %}
