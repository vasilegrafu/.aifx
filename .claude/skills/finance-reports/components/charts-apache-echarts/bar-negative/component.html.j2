{# purpose: a measure that crosses zero — variance, surprise, contribution #}
{# unit: axis — one measured axis; name it with y_name #}
{# data: series[] {name:str, points:num[]}   categories: str[] #}
{% import "charts-apache-echarts/_render.html.j2" as r %}

{% macro charts_apache_echarts_bar_negative(series=[], categories=[], caption="", height=340, note="", y_name="", unit="") %}
{# Each bar is coloured by the SIGN of its value. This is the one sanctioned use
   of the semantic tones: direction is not identity, so it does not consume a
   categorical slot. The colour is never the only cue — position relative to
   the zero line says the same thing, which is what keeps the chart readable
   under red/green colour blindness. #}
{% set built = [] %}
{% for s in series %}
{%   set marks = [] %}
{%   for value in s.points %}
{%     set _ = marks.append({"value": value,
                             "itemStyle": {"color": "token:positive" if value >= 0
                                                    else "token:negative"}}) %}
{%   endfor %}
{%   set _ = built.append({"type": "bar", "name": s.name, "data": marks}) %}
{% endfor %}
{# The axis NAME sits at a fixed offset and `containLabel` does NOT
   reserve room for it, so a hardcoded gap collides with the tick labels the
   moment the values get wide. Derived from the widest tick instead --
   `axis_gap` in _showcase_controller.py has the reasoning. #}
{% set _gap = series | axis_gap %}
{% set y_axis = {"type": "value"} %}
{% if y_name %}
{%   set _ = y_axis.update({"name": y_name, "nameLocation": "middle",
                            "nameGap": _gap, "nameRotate": 90}) %}
{% endif %}
{% set option = {
     "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}},
     "grid": {"left": (_gap if y_name else 8), "right": 16, "bottom": 8, "containLabel": true},
     "xAxis": {"type": "category", "data": categories},
     "yAxis": y_axis,
     "series": built,
   } %}
{% if built | length > 1 %}
{%   set _ = option.update({"legend": {}}) %}
{% endif %}
{{ r.out(option, height, note, caption, unit) }}
{% endmacro %}
