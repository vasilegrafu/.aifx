{# The `waterfall` showcase -- the VIEW. It receives `d` from
   showcase_controller.py and is the only place a macro is called. Each
   <section> is one state worth seeing. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>a bridge with deltas in both directions — the standard form</h3>
      {{ c.charts_apache_echarts_waterfall(steps=d.revenue_bridge,
               caption="Revenue bridge, FY21 to FY25",
               unit="USD millions",
               y_name="Revenue (USD m)",
               note="Two retired segments cost 16.4bn; the four live ones more than replaced it.") }}
    </section>
    <hr>
    <section>
      <h3>all-negative deltas — a walk down from a subtotal</h3>
      {{ c.charts_apache_echarts_waterfall(steps=d.margin_walk,
               caption="Gross profit to operating income",
               unit="USD millions",
               height=320,
               note="R&D is the largest single step down, at 47% of gross profit.") }}
    </section>
{% endblock %}
