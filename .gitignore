# Python bytecode — builders are run in place from the repo, so these appear
# next to the sources. They are build artifacts, never content.
__pycache__/
*.py[cod]

# The virtual environment. requirements.txt is the tracked half; the installed
# tree is per-machine and per-platform.
.venv/

# Credentials. This repo is PUBLIC and jsDelivr serves it, so anything
# committed here is fetchable at a URL by anyone who guesses the path.
# Keys live in the FMP_API_KEY environment variable, or in these files, which
# never leave the machine. Selected by AIFX_ENV (dev | prod, default dev).
secrets.*.json
# ...except the TEMPLATE, which carries a placeholder and is never read by any
# code. It is a separate filename on purpose: `git add .` must never be able to
# stage a file that holds a real key, and the two roles cannot share a name.
!secrets.example.json

# Generated reports. A report is a build artifact — the controller and the view
# are the source, and regenerating from the same symbol gives the same file
# with newer numbers. Nothing in here is hand-edited, so nothing is worth
# committing.
output/*
!output/.gitkeep




