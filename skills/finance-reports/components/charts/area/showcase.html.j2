{# The `area` showcase — the VIEW. It receives `d` from showcase_controller.py
   and is the only place a macro is called, exactly as a report's
   report.html.j2 is. Each <section> is one state worth seeing.

   Every series drawn here is a level or a cumulative flow. That is not a
   stylistic choice: the fill asserts the quantity beneath the line is real,
   so a showcase drawing a ratio would be demonstrating the one thing this
   component's usage.md forbids. #}
{% extends "_showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>single series — the fill is the quantity, not decoration</h3>
      {{ c.area(series=[d.cash], categories=d.quarters,
                caption="Cash and equivalents",
                unit="USD, billions",
                note="A level, so the area beneath the line is money actually held.") }}
    </section>
    <hr>
    <section>
      <h3>two series — a legend appears, and this is the documented maximum</h3>
      {{ c.area(series=[d.fy24, d.fy23], categories=d.quarters,
                caption="This year vs last",
                unit="USD, billions",
                note="Two translucent fills still read; a third would hide one of these.") }}
    </section>
    <hr>
    <section>
      <h3>named axis — y_name labels the axis, unit names the measure</h3>
      {{ c.area(series=[d.capex_ytd], categories=d.quarters,
                caption="Capital expenditure, cumulative",
                unit="USD, billions",
                y_name="USD (billions)",
                note="A cumulative flow only rises; the area is the total spent to date.") }}
    </section>
    <hr>
    <section>
      <h3>36 points — past the cutoff the symbols drop and the shape carries it</h3>
      {{ c.area(series=[d.backlog], categories=d.months,
                caption="Backlog by month",
                unit="USD, billions",
                y_name="USD (billions)",
                height=380,
                note="Beyond 24 categories the macro hides the point markers, so
                      the filled band is what a reader follows.") }}
    </section>
{% endblock %}
