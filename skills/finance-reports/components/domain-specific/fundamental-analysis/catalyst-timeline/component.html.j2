{# purpose: dated catalysts ahead, with expected direction and likelihood #}
{# data: items[] {date:str, event:str, direction:up|down|mixed, likelihood?:str, note?:str} #}
{% macro catalyst_timeline(items=[]) %}
  <ol class="fa-catalysts">
  {% for it in items %}
    <li class="fa-catalyst fa-catalyst-{{ it.direction }}">
      <span class="fa-catalyst-date">{{ it.date }}</span>
      <span class="fa-catalyst-dir" aria-hidden="true">{{ {"up": "▲", "down": "▼"}.get(it.direction, "◆") }}</span>
      <span class="fa-catalyst-body">
        <span class="fa-catalyst-event">{{ it.event }}</span>
        {% if it.likelihood %}<span class="fa-catalyst-likelihood">{{ it.likelihood }}</span>{% endif %}
        {% if it.get('note') %}<span class="fa-catalyst-note">{{ it.note }}</span>{% endif %}
      </span>
    </li>
  {% endfor %}
  </ol>
{% endmacro %}
