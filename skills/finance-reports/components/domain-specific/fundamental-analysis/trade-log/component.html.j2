{# purpose: dated trades with side, size, price, result and the rationale that justified them #}
{# data: rows[] {date:str, symbol:str, side:buy|sell, size:str, price:str, result:str, rationale?:str} #}
{% macro trade_log(rows=[], caption="") %}
  <table class="investing-fin investing-tradelog">
  {% if caption %}<caption>{{ caption }}</caption>{% endif %}
    <thead><tr><th>Date</th><th>Instrument</th><th>Side</th><th>Size</th><th>Price</th><th>Result</th></tr></thead>
    <tbody>
    {% for r in rows %}
      <tr class="investing-trade">
        <td class="investing-trade-date">{{ r.date }}</td>
        <th scope="row">{{ r.symbol }}</th>
        <td><span class="investing-side investing-side-{{ r.side | lower }}">{{ r.side }}</span></td>
        <td>{{ r.size }}</td>
        <td>{{ r.price }}</td>
        <td{% if r.result is string and (r.result.startswith("-") or r.result.startswith("−")) %} class="neg"{% endif %}>{{ r.result }}</td>
      </tr>
      {% if r.get('rationale') %}
      <tr class="investing-trade-note"><td colspan="6">{{ r.rationale }}</td></tr>
      {% endif %}
    {% endfor %}
    </tbody>
  </table>
{% endmacro %}
