{# purpose: identity strip for the security under analysis: ticker, name, key market data #}
{# data: facts[] {label:str, value:str} — pre-formatted, because these are
         heterogeneous (a price, a market cap, a sector name) and no single
         numeric format fits them #}
{% macro security_header(ticker="", name="", exchange="", asof="", facts=[]) %}
  <header class="fa-sec-header">
    <p class="fa-sec-id">
      <span class="fa-sec-ticker">{{ ticker }}</span>
      <span class="fa-sec-name">{{ name }}</span>
      {% if exchange %}<span class="fa-sec-exchange">{{ exchange }}</span>{% endif %}
    </p>
    {% if facts %}
    <dl class="fa-sec-facts">
      {% for f in facts %}
      <div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>
      {% endfor %}
    </dl>
    {% endif %}
    {# `asof` is a MARKET data date and is not the filing date, the period end,
       or the build date. Reports conflate those four routinely. #}
    {% if asof %}<p class="fa-sec-asof">Market data as of {{ asof }}</p>{% endif %}
  </header>
{% endmacro %}
