{# purpose: multi-period income statement: the revenue-to-net-income ladder with margin lines #}
{# data: rows[] {label:str, cells:num[], kind:section|detail|subtotal|total, note?:str} — raw numbers #}
{% macro income_statement(periods=[], rows=[], caption="", unit="", source="", fmt="money") %}
  <table class="fin fa-statement st-income">
  {% if caption or unit %}<caption>{{ caption }}{% if unit %} <span class="fa-st-unit">{{ unit }}</span>{% endif %}</caption>{% endif %}
    <thead><tr><th>{{ "" }}</th>{% for p in periods %}<th>{{ p }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for r in rows %}
      <tr class="fa-st-{{ r.get('kind') or 'line' }}">
        <th scope="row">{{ r.label }}{% if r.get('note') %} <a class="fa-st-note" href="#note-{{ r.note }}">{{ r.note }}</a>{% endif %}</th>
        {% for v in r.cells %}<td{% if v is number and v < 0 %} class="neg"{% endif %}>{{ v | fmt(fmt) }}</td>{% endfor %}
        {% for _ in range(periods | length - r.cells | length) %}<td></td>{% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if source %}<p class="fa-st-source">{{ source }}</p>{% endif %}
{% endmacro %}
