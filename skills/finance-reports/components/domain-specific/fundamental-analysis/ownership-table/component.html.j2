{# purpose: who owns the company: top holders, stake, and recent change #}
{# data: summary[] {label, value}   rows[] {holder:str, type:str, shares:str, stake:num, change:str, tone?:str} #}
{% macro ownership_table(rows=[], summary=[], caption="", asof="", note="") %}
  {% if summary %}
  <dl class="fa-own-summary">
    {% for sm in summary %}
    <div><dt>{{ sm.label }}</dt><dd>{{ sm.value }}</dd></div>
    {% endfor %}
  </dl>
  {% endif %}
  <table class="fin ownership">
  {% if caption or asof %}<caption>{{ caption }}{% if asof %} <span class="macro-macro-asof">as of {{ asof }}</span>{% endif %}</caption>{% endif %}
    <thead><tr><th>Holder</th><th>Type</th><th>Shares</th><th class="fa-own-stake-head">Stake</th><th>Change</th></tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.holder }}</th>
        <td class="fa-own-type">{{ r.type }}</td>
        <td>{{ r.shares }}</td>
        <td class="fa-own-stake">
          <span class="fa-own-track"><span class="fa-own-fill" data-pct="{{ r.stake }}%"></span></span>
          <span class="fa-own-pct">{{ r.stake }}%</span>
        </td>
        <td{% if r.get('tone') %} class="tone-{{ r.tone }}"{% endif %}>{{ r.change }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if note %}<p class="fa-st-source">{{ note }}</p>{% endif %}
{% endmacro %}
