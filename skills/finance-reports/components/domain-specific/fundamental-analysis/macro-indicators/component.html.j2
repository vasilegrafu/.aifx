{# purpose: economic indicators with latest, prior, consensus, surprise and direction #}
{# data: rows[] {indicator:str, latest:str, prior:str, consensus:str, surprise:str, dir:up|down|flat} #}
{% macro macro_indicators(rows=[], caption="", asof="") %}
  <table class="investing-fin macro">
  {% if caption or asof %}<caption>{{ caption }}{% if asof %} <span class="investing-macro-asof">as of {{ asof }}</span>{% endif %}</caption>{% endif %}
    <thead><tr><th>Indicator</th><th>Latest</th><th>Prior</th><th>Consensus</th><th>Surprise</th><th class="investing-trend-head">Trend</th></tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.indicator }}</th>
        <td class="investing-macro-latest">{{ r.latest }}</td>
        <td>{{ r.prior }}</td>
        <td>{{ r.consensus }}</td>
        <td{% if r.surprise is string and (r.surprise.startswith("-") or r.surprise.startswith("−")) %} class="neg"{% endif %}>{{ r.surprise }}</td>
        <td class="investing-trend investing-trend-{{ r.dir }}">{{ {"up": "▲", "down": "▼"}.get(r.dir, "▬") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endmacro %}
