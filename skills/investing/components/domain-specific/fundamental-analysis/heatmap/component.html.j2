{# purpose: value grid with colour-graded cells — monthly returns, correlations, sector by region #}
{# data: cols: str[]   rows[] {row_head:str, cells[] {display:str, level:-3..3}} #}
{% macro heatmap(cols=[], rows=[], caption="", corner="", legend="") %}
  <table class="investing-heatmap">
  {% if caption %}<caption>{{ caption }}</caption>{% endif %}
    <thead><tr><th class="hm-corner">{{ corner }}</th>{% for c in cols %}<th>{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <th scope="row">{{ r.row_head }}</th>
        {% for c in r.cells %}
        <td class="investing-hm-cell investing-hm-{{ 'p' if c.level > 0 else ('n' if c.level < 0 else 'z') }}{{ c.level | abs }}">{{ c.display }}</td>
        {% endfor %}
        {% for _ in range(cols | length - r.cells | length) %}<td class="investing-hm-empty"></td>{% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if legend %}<p class="investing-hm-legend">{{ legend }}</p>{% endif %}
{% endmacro %}
