{# purpose: allocation breakdown as labeled percentage bars — sector, geography, asset class #}
{# data: items[] {label:str, percent:num, value?:str} — value is free text (amount, target, delta) #}
{% macro exposure_bars(items=[], caption="") %}
  <figure class="investing-exposure">
  {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
    {% for it in items %}
    <div class="investing-exposure-row">
      <span class="investing-exposure-label">{{ it.label }}</span>
      <span class="investing-exposure-track"><span class="investing-exposure-fill" data-pct="{{ it.percent }}%"></span></span>
      <span class="investing-exposure-value">{{ it.percent }}%{% if it.get('value') %} <em>{{ it.value }}</em>{% endif %}</span>
    </div>
    {% endfor %}
  </figure>
{% endmacro %}
