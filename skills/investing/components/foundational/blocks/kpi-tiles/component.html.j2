{# purpose: row of headline metric tiles with trend #}
{# data: tiles[] {value:str, label:str, dir:up|down|flat, delta:str} #}
{% macro kpi_tiles(tiles=[]) %}
  <div class="kpi-tiles">
  {% for t in tiles %}
    <div class="kpi">
      <span class="kpi-value">{{ t.value }}</span>
      <span class="kpi-label">{{ t.label }}</span>
      <span class="kpi-trend {{ t.dir }}">{{ t.delta }}</span>
    </div>
  {% endfor %}
  </div>
{% endmacro %}
