{# The `bar` showcase — the VIEW. It receives `d` from showcase_controller.py
   and is the only place a macro is called, exactly as a report's
   report.html.j2 is. Each <section> is one state worth seeing. #}
{% extends "showcase.master.html.j2" %}
{% block content %}
    <section>
      <h3>single series — unit as a subtext line under the caption</h3>
      {{ c.bar(series=[d.revenue], categories=d.quarters,
               caption="Revenue by quarter",
               unit="USD, billions",
               note="Cloud momentum builds through the year.") }}
    </section>
    <hr>
    <section>
      <h3>two series — a legend appears, colour is never the only cue</h3>
      {{ c.bar(series=[d.fy24, d.fy23], categories=d.quarters,
               caption="This year vs last",
               unit="USD, billions",
               note="Every quarter ahead of the prior year.") }}
    </section>
    <hr>
    <section>
      <h3>named axis — y_name labels the axis, unit names the measure</h3>
      {{ c.bar(series=[d.by_segment], categories=d.segments,
               caption="Segment revenue",
               unit="USD, billions",
               y_name="USD (billions)",
               note="Cloud is now the largest single line.") }}
    </section>
    <hr>
    <section>
      <h3>percentages — a different unit family, same component</h3>
      {{ c.bar(series=[d.margin_by_segment], categories=d.segments,
               caption="Operating margin by segment",
               unit="percent",
               y_name="Operating margin (%)",
               note="License carries the business; hardware dilutes it.") }}
    </section>
{% endblock %}
