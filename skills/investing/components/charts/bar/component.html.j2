{# purpose: a measure across categories — the workhorse comparison #}
{# unit: axis — one measured axis; s.name it with y_name #}
{# data: series[] {name:str, points:num[]}   categories: str[] #}
{% import "components/charts/_render.html.j2" as r %}

{% macro bar(series=[], categories=[], caption="", height=340, note="", y_name="", unit="") %}
{# Built as data and serialised once — see the note in line/component.html.j2. #}
{% set built = [] %}
{% for s in series %}
{%   set _ = built.append({"type": "bar", "s.name": s.name, "data": s.points}) %}
{% endfor %}
{# A named value axis sits MID-axis and rotated: ECharts puts the s.name at the
   END by default, which is exactly where the title is. containLabel reserves
   room for tick labels but NOT for an axis s.name, so the left margin has to
   widen too — otherwise the s.name renders off the card and disappears. #}
{% set y_axis = {"type": "value"} %}
{% if y_name %}
{%   set _ = y_axis.update({"s.name": y_name, "nameLocation": "middle",
                            "nameGap": 46, "nameRotate": 90}) %}
{% endif %}
{# A bar chart's axis pointer is a shadow band over the whole category, not a
   line: the value belongs to the bar, not to a point on the axis. #}
{% set option = {
     "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}},
     "grid": {"left": (46 if y_name else 8), "right": 16, "bottom": 8, "containLabel": true},
     "xAxis": {"type": "category", "data": categories},
     "yAxis": y_axis,
     "series": built,
   } %}
{# Identity is never colour alone: from two series up, s.name them in a legend. #}
{% if built | length > 1 %}
{%   set _ = option.update({"legend": {}}) %}
{% endif %}
{{ r.out(option, height, note, caption, unit) }}
{% endmacro %}
