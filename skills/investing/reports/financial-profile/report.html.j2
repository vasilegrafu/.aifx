{# report-name: Financial Profile #}
{# purpose: where a company's money comes from, where it goes, what it owns, and how that shape changed #}
{#
   THE RECIPE. This file decides WHICH exhibits appear and IN WHAT ORDER, and
   nothing else. It holds no arithmetic — every number arrives already derived
   and already asserted by report.controller.py — and it performs no I/O.

   Reading it top to bottom should tell you what the report argues:
     what it is -> where money comes from -> where it goes -> what it owns ->
     what a share owns -> how that changed -> how it compares.

   FULLY GENERATED. There are no prose slots: every exhibit is built from data,
   so the output carries no `{{...}}` prompts and needs no hand editing. The
   report is what the numbers say; interpretation is the reader's.
#}
{% extends "reports/report.master.html.j2" %}
{% block content %}
  {{ c.toc([
      {"id": "snapshot",  "label": "Snapshot"},
      {"id": "income",    "label": "Where the money comes from"},
      {"id": "cash",      "label": "Where the money goes"},
      {"id": "position",  "label": "What it owns and owes"},
      {"id": "per-share", "label": "Per share"},
      {"id": "evolution", "label": "How it evolved"},
      {"id": "peers",     "label": "How it compares"},
  ]) }}

  {% call c.section("snapshot", "Snapshot") %}
    {{ c.security_header(ticker=d.ticker, name=d.company, exchange=d.exchange,
                         asof=d.price_date, facts=d.header_facts) }}
    {# BASIS OF PREPARATION. Every figure below is stale by construction — a
       filing describes a period that has already ended. Stating the report date
       lets a reader MEASURE that staleness instead of guessing it. Three dates
       get conflated routinely: when the period ended, when it was filed, and
       when the price was taken. They are not the same date. #}
    {% call c.callout("note") %}
      {{ c.facts(d.basis_facts) }}
    {% endcall %}
  {% endcall %}

  {% call c.section("income", "Where the money comes from") %}
    {# Rooted at Revenue rather than at the segments, deliberately: segment
       disclosure often lags the statements by a year, and splicing two periods
       into one diagram would make it silently wrong. Segments get their own
       exhibits below, on their own dates. #}
    {{ c.sankey(nodes=d.inc_nodes, links=d.inc_links, height=460, unit=d.unit,
                caption=d.inc_caption) }}
    {# No profit columns: the product-segmentation feed publishes revenue only,
       and the macro renders a narrower table rather than a fabricated one. #}
    {{ c.segment_reporting(rows=d.seg_rows, total_row=d.seg_total_row,
                           caption=d.seg_caption, unit=d.unit) }}
  {% endcall %}

  {% call c.section("cash", "Where the money goes") %}
    {# The section above is ACCOUNTING; this one is CASH, and they disagree.
       Buybacks, dividends and debt repayment consume real money and appear
       nowhere on the income statement. Investing is grossed up rather than
       netted, so capital expenditure stays a visible node. #}
    {{ c.sankey(nodes=d.cash_nodes, links=d.cash_links, height=400, unit=d.unit,
                caption=d.cash_caption) }}
  {% endcall %}

  {% call c.section("position", "What it owns and owes") %}
    {# A BALANCE SHEET IS A STOCK, NOT A FLOW. Nothing moves along these ribbons;
       the roles encode direction and there is no direction here. The picture
       shows composition and claim — a reader trained by the two sankeys above
       must not read movement into it. #}
    {{ c.sankey(nodes=d.bs_nodes, links=d.bs_links, height=380, label_room=190,
                unit=d.bs_unit, caption=d.bs_sankey_caption) }}
    {{ c.balance_sheet(periods=d.bs_periods, rows=d.bs_rows, unit=d.unit,
                       caption=d.bs_caption, check=d.bs_check) }}
    {# A solvency score is standard, free and instantly readable — and dominated
       by one term far more often than a reader expects, which is why the inputs
       are shown rather than just the number. #}
    {{ c.composite_score(name=d.z_name, formula=d.z_formula, inputs=d.z_inputs,
                         score=d.z_score, band=d.z_band, tone=d.z_tone,
                         bands=d.z_bands, caption="Solvency") }}
  {% endcall %}

  {% call c.section("per-share", "Per share") %}
    {# The section most profiles omit, and the one that explains shareholder
       returns. A company can grow revenue slowly and per-share revenue quickly
       by retiring stock; the totals above never show it. #}
    {{ c.roll_forward(periods=d.share_periods, rows=d.roll_rows,
                      caption="Shares outstanding, weighted average",
                      unit="millions") }}
    {{ c.metric_trend(periods=d.periods, rows=d.pershare_rows,
                      caption="Per-share record", unit="$ per share") }}
  {% endcall %}

  {% call c.section("evolution", "How it evolved") %}
    {{ c.metric_trend(periods=d.seg_years, rows=d.seg_trend_rows, fmt="money",
                      caption="Revenue by segment, five fiscal years", unit=d.unit) }}
    {# TOTALS BEFORE SHARES. This shows the business getting bigger and which
       parts did it; the 100% chart that follows shows only the mix. In this
       order — a reader who sees composition shift before seeing the total move
       cannot tell growth from substitution.
       In a stacked area only the BOTTOM band and the TOTAL are readable by eye,
       which is exactly why the normalised chart follows rather than replaces. #}
    {{ c.stacked_area(series=d.seg_series, categories=d.seg_years, unit=d.unit,
                      caption="Revenue by segment — total and composition") }}
    {{ c.stacked_normalized(series=d.seg_series, categories=d.seg_years,
                            caption="Revenue mix — each year as 100%") }}
    {# The bridge prices the mix shift: growth is rarely spread evenly, and one
       segment usually paid for all of it. #}
    {{ c.bridge(steps=d.bridge_steps, scale_min=d.bridge_min, scale_max=d.bridge_max,
                caption=d.bridge_caption) }}
    {{ c.metric_trend(periods=d.periods, rows=d.margin_rows, fmt="pct",
                      caption="Margins and returns, five fiscal years") }}
  {% endcall %}

  {% call c.section("peers", "How it compares") %}
    {# A margin, a multiple or a return is meaningless alone. Fiscal year ends
       rarely align, which the caption states rather than hides. #}
    {{ c.peer_comparison(headers=d.peer_headers, formats=d.peer_formats,
                         rows=d.peer_rows, caption=d.peer_caption) }}
  {% endcall %}
{% endblock %}
